---
/**
 * About. Prose on the left in Chris's own words (carried over from the legacy page);
 * on the right, the spec sheet: who, the rig, the stack, where to find him.
 */
import AppLayout from '@/layouts/AppLayout.astro';
import Decode from '@/components/system/Decode.astro';
import OceanWindow from '@/components/home/OceanWindow';

type Row = { k: string; v: string; href?: string };
const SHEET: { label: string; rows: Row[] }[] = [
  {
    label: 'who',
    rows: [
      { k: 'name', v: 'Christopher Keesey' },
      { k: 'handle', v: 'c2k' },
      { k: 'role', v: 'CTO, context engineer' },
      { k: 'company', v: 'MAIA Analytics', href: 'https://maia-analytics.com' },
      { k: 'location', v: 'Outer Sunset, San Francisco' },
    ],
  },
  {
    label: 'rig',
    rows: [
      { k: 'editor', v: 'Claude Code' },
      { k: 'terminal', v: 'Ghostty and tmux' },
      { k: 'keyboard', v: 'Corne, 42 keys, split' },
      { k: 'host', v: 'OptiPlex micro running Ubuntu' },
      { k: 'network', v: 'Tailscale and a Cloudflare Tunnel' },
      { k: 'whip', v: 'Maroon Honda Odyssey' },
    ],
  },
  {
    label: 'stack',
    rows: [
      { k: 'languages', v: 'Natural language, TypeScript, Python, Go' },
      { k: 'frontend', v: 'React, Astro, Tailwind' },
      { k: 'backend', v: 'FastAPI, Node, Postgres' },
      { k: 'infra', v: 'GCP, Docker, systemd, Cloudflare' },
      { k: 'ai', v: 'Claude Code, MCP, Pydantic AI' },
    ],
  },
  {
    label: 'elsewhere',
    rows: [
      { k: 'github', v: 'c2keesey', href: 'https://github.com/c2keesey' },
      { k: 'x', v: 'c2keesey', href: 'https://x.com/c2keesey' },
      { k: 'linkedin', v: 'c2keesey', href: 'https://linkedin.com/in/c2keesey' },
    ],
  },
];
---

<AppLayout title="About" description="Christopher Keesey: CTO at MAIA Analytics, maker of things that don't need to exist, Outer Sunset.">
  <OceanWindow client:only="react" quiet />

  <Decode as="h1" text="About" class="mb-10 block font-display text-3xl lg:mb-14" />

  <div class="grid gap-x-20 gap-y-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)]">
    <div class="max-w-[60ch] space-y-6 text-lg leading-[1.7] text-muted-foreground sm:text-xl sm:leading-[1.65]">
      <p class="text-foreground">
        CTO at <a href="https://maia-analytics.com" target="_blank" rel="noopener" class="underline decoration-border-strong underline-offset-4 hover:decoration-primary">MAIA Analytics</a>.
        The pitch is that you ask a question about a property and get a map back. The reality is a lot of LLM orchestration and a lot of data pipelines that have to be right, because a map that is confidently wrong is worse than no map.
      </p>
      <p>
        Outside of that I solder things that don’t need to exist. A 300-LED gauntlet. A cloud that generates its own lightning. A keyboard with 42 keys, which is fewer than you think you need and turns out to be enough. Most of my week is Claude Code in a terminal. The rest is Ocean Beach, backcountry when there’s snow, and more time mixing drum and bass than I’d defend in public.
      </p>
      <p>
        All of this runs on a used OptiPlex micro under my desk, this site included. The status line at the bottom of the page is real. If it goes red, something in my apartment is actually broken.
      </p>
      <p>
        The water behind this page is real too: the sun is where it is over Ocean Beach right now, and the shoreline moves with the tide.
      </p>
    </div>

    <div class="min-w-0 space-y-9 lg:pt-1.5">
      {SHEET.map((group) => (
        <section aria-label={group.label}>
          <h2 class="chrome mb-2">{group.label}</h2>
          <dl class="divide-y divide-border border-y border-border">
            {group.rows.map((r) => (
              <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-baseline gap-x-4 py-2">
                <dt class="font-mono text-xs text-faint-foreground">{r.k}</dt>
                <dd class="min-w-0 text-sm text-foreground">
                  {r.href ? (
                    <a href={r.href} target="_blank" rel="noopener me" class="underline decoration-border-strong underline-offset-4 hover:decoration-primary">{r.v}</a>
                  ) : (
                    r.v
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>
</AppLayout>
