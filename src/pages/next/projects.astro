---
/**
 * The project network. Desktop (≥1024px) is the spatial metro map; phones get the
 * same network as transit-line strip maps. Both read src/data/projects.ts.
 *
 * The bespoke showcases are server-rendered here, parked off-screen at the width they
 * were designed for, and moved into the map's dock (or the phone's sheet) on demand.
 */
import AppLayout from '@/layouts/AppLayout.astro';
import ProjectNetwork from '@/components/network/ProjectNetwork';
import MobileNetwork from '@/components/network/MobileNetwork';
import MaiaShowcase from '@/components/MaiaShowcase.astro';
import C2kShowcase from '@/components/C2kShowcase.astro';
import DotfilesShowcase from '@/components/DotfilesShowcase.astro';
import StatuslineShowcase from '@/components/StatuslineShowcase.astro';
import SpotifyMacroShowcase from '@/components/SpotifyMacroShowcase.astro';
import FluxGauntletShowcase from '@/components/FluxGauntletShowcase.astro';
import CorneShowcase from '@/components/CorneShowcase.astro';
import LightningCloudShowcase from '@/components/LightningCloudShowcase.astro';
import AllLookDifferentShowcase from '@/components/AllLookDifferentShowcase.astro';
---

<AppLayout title="Projects" description="Everything Christopher Keesey builds, as a live network: projects, small builds, and how they connect." bleed hideStrip>
  <div class="hidden h-[calc(100dvh-3rem)] min-h-[700px] lg:block">
    <ProjectNetwork client:media="(min-width: 1024px)" />
  </div>
  <div class="lg:hidden">
    <MobileNetwork client:media="(max-width: 1023.98px)" />
  </div>

  <div class="showcase-source" aria-hidden="true">
    <div data-showcase-src="maia"><MaiaShowcase /></div>
    <div data-showcase-src="c2k"><C2kShowcase /></div>
    <div data-showcase-src="dotfiles"><DotfilesShowcase /></div>
    <div data-showcase-src="statusline"><StatuslineShowcase /></div>
    <div data-showcase-src="spotify"><SpotifyMacroShowcase /></div>
    <div data-showcase-src="flux"><FluxGauntletShowcase /></div>
    <div data-showcase-src="corne"><CorneShowcase /></div>
    <div data-showcase-src="lightning"><LightningCloudShowcase /></div>
    <div data-showcase-src="alldifferent"><AllLookDifferentShowcase /></div>
  </div>
</AppLayout>

<style>
  /* off-screen but laid out, so the showcases' canvases initialise at a real width */
  .showcase-source {
    position: absolute;
    left: -9999px;
    top: 0;
    width: 640px;
    visibility: hidden;
    pointer-events: none;
  }
</style>
