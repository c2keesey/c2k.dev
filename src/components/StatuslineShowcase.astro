---
// Interactive Codex statusline showcase with animated context fill
// Tap to expand for detailed breakdown
---

<div class="showcase" id="sl-showcase">
  <div class="showcase-header">
    <span class="showcase-label text-scramble" data-text="Codex Statusline" data-delay="200" data-always="false">Codex Statusline</span>
    <a class="showcase-tag" href="https://github.com/c2keesey/codex-statusline" target="_blank" rel="noopener">
      github/codex-statusline ↗
    </a>
  </div>

  <div class="terminal" id="statusline-terminal">
    <div class="terminal-chrome">
      <span class="dot red"></span>
      <span class="dot yellow"></span>
      <span class="dot green"></span>
      <span class="terminal-title">codex-statusline</span>
    </div>
    <div class="terminal-body">
      <div class="sl-line1" id="sl-line1">
        <span class="sl-segment" data-label="git branch" data-desc="Current branch, truncated at 30 chars">
          <span class="sl-branch">main</span>
        </span>
        <span class="sl-segment" data-label="changes" data-desc="Staged + unstaged + untracked file count">
          <span class="sl-changes">±3</span>
        </span>
        <span class="sl-sep">│</span>
        <span class="sl-segment" data-label="directory" data-desc="Shortened working directory path">
          <span class="sl-cwd">~/repos/c2k.dev</span>
        </span>
      </div>
      <div class="sl-line2" id="sl-line2">
        <span class="sl-segment" data-label="context usage" data-desc="Live Codex context usage, read from the native footer with a rollout fallback.">
          <span class="sl-ctx" id="sl-ctx">0%</span>
        </span>
        <span class="sl-segment" data-label="weekly usage" data-desc="Seven-day allowance plus actual burn versus expected pace.">
          <span class="sl-model">7d ◰◱◱◱ 30% ⇡0.8×</span>
        </span>
        <span class="sl-sep">│</span>
        <span class="sl-segment" data-label="system stats" data-desc="CPU load and memory usage, cached every second">
          <span class="sl-stats">↯12 ⛁43</span>
        </span>
        <span class="sl-sep">│</span>
        <span class="sl-segment" data-label="session" data-desc="Compact Agent Deck session identity.">
          <span class="sl-port">feature-work_5af</span>
        </span>
      </div>
    </div>
  </div>

  <div class="tooltip" id="sl-tooltip"></div>

  <button class="expand-trigger" id="sl-expand-btn">
    <span class="expand-text">tap to explore</span>
    <span class="expand-arrow" id="sl-expand-arrow">↓</span>
  </button>

  <div class="expanded-content" id="sl-expanded-content">
    <div class="detail-section">
      <h3 class="detail-title">What is this?</h3>
      <p class="detail-text">
        A small Go utility that gives Codex a richer native footer and adds the machine signals Codex cannot expose through an optional tmux companion.
      </p>
    </div>

    <div class="detail-section">
      <h3 class="detail-title">Native footer — Codex-owned state</h3>
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-key">Branch</span>
          <span class="detail-val">Current branch and working-tree change count, rendered by Codex itself.</span>
        </div>
        <div class="detail-item">
          <span class="detail-key">Thread</span>
          <span class="detail-val">The live Codex thread title stays visible across tmux, SSH, and resizes.</span>
        </div>
        <div class="detail-item">
          <span class="detail-key">±N</span>
          <span class="detail-val">The model and reasoning effort come from Codex's native status fields.</span>
        </div>
        <div class="detail-item">
          <span class="detail-key">Path</span>
          <span class="detail-val">Codex owns the current directory display, so it follows pane state without polling.</span>
        </div>
      </div>
    </div>

    <div class="detail-section">
      <h3 class="detail-title">Tmux companion — usage + machine</h3>
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-key">Context %</span>
          <span class="detail-val">Reads the live native footer first, with the session rollout as a compaction-aware fallback.</span>
        </div>
        <div class="detail-item">
          <span class="detail-key">7d + ⇡</span>
          <span class="detail-val">A four-cell weekly allowance gauge plus actual spend divided by expected spend.</span>
        </div>
        <div class="detail-item">
          <span class="detail-key">↯ ⛁</span>
          <span class="detail-val">Cross-platform CPU load and memory usage, kept out of the Codex pane itself.</span>
        </div>
        <div class="detail-item">
          <span class="detail-key">Session</span>
          <span class="detail-val">Keeps the Agent Deck name and a short unique suffix without repeating tmux chrome.</span>
        </div>
      </div>
    </div>

    <div class="detail-section">
      <h3 class="detail-title">Why native-first?</h3>
      <p class="detail-text">
        Codex already knows git, context, model, effort, limits, and thread state. The tool configures those official fields, then uses tmux only for CPU, memory, burn pace, and Agent Deck identity. Less scraping, fewer stale values.
      </p>
    </div>
  </div>
</div>

<script>
  function initShowcase() {
    const ctx = document.getElementById('sl-ctx');
    const tooltip = document.getElementById('sl-tooltip');
    const segments = document.querySelectorAll<HTMLElement>('.sl-segment');
    const expandBtn = document.getElementById('sl-expand-btn');
    const expandedContent = document.getElementById('sl-expanded-content');
    const expandArrow = document.getElementById('sl-expand-arrow');
    const showcase = document.getElementById('sl-showcase');
    if (!ctx || !expandBtn || !expandedContent || !showcase) return;

    let isExpanded = false;

    // Animate context percentage on a loop
    let pct = 0;
    let direction = 1;
    const speed = 30;

    function ctxColor(v: number): string {
      let r: number, g: number;
      if (v < 60) {
        r = 0; g = 255;
      } else if (v < 100) {
        const t = (v - 60) / 40;
        r = Math.round(t * 255);
        g = Math.round((1 - t) * 255);
      } else {
        r = 255; g = 0;
      }
      return `rgb(${r}, ${g}, 0)`;
    }

    let animating = true;

    function tick() {
      if (!animating) return;
      pct += direction * 0.5;
      if (pct >= 100) { direction = -1; pct = 100; }
      if (pct <= 0) { direction = 1; pct = 0; }

      const displayPct = Math.round(pct);
      ctx.textContent = `${displayPct}%`;
      ctx.style.color = ctxColor(displayPct);

    }

    const interval = setInterval(tick, speed);

    // Tap terminal to pause/resume animation
    const terminal = document.getElementById('statusline-terminal');
    terminal?.addEventListener('click', () => {
      animating = !animating;
    });

    // Tooltip on hover/tap for segments
    let isTouch = false;

    segments.forEach(seg => {
      seg.addEventListener('pointerdown', (e) => {
        isTouch = e.pointerType === 'touch';
      });

      seg.addEventListener('mouseenter', () => {
        if (isTouch) return;
        const label = seg.dataset.label || '';
        const desc = seg.dataset.desc || '';
        tooltip.textContent = `${label}: ${desc}`;
        tooltip.classList.add('visible');
        seg.classList.add('highlighted');
      });

      seg.addEventListener('mouseleave', () => {
        if (isTouch) return;
        tooltip.classList.remove('visible');
        seg.classList.remove('highlighted');
      });

      seg.addEventListener('click', () => {
        const wasHighlighted = seg.classList.contains('highlighted');
        segments.forEach(s => s.classList.remove('highlighted'));
        tooltip.classList.remove('visible');

        if (!wasHighlighted) {
          const label = seg.dataset.label || '';
          const desc = seg.dataset.desc || '';
          tooltip.textContent = `${label}: ${desc}`;
          tooltip.classList.add('visible');
          seg.classList.add('highlighted');
        }
      });
    });

    // Expand/collapse
    expandBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      expandedContent.classList.toggle('open', isExpanded);
      expandArrow.textContent = isExpanded ? '↑' : '↓';
      expandBtn.querySelector('.expand-text')!.textContent = isExpanded ? 'collapse' : 'tap to explore';
    });

    // Cleanup
    document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
  }

  initShowcase();
</script>

<style>
  .showcase {
    margin-top: 1.5rem;
  }

  .showcase-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .showcase-label {
    font-weight: 600;
    font-size: 1rem;
  }

  .showcase-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: var(--purple-bg);
    color: var(--purple);
    border-radius: 4px;
    transition: background 0.2s;
    text-decoration: none;
  }

  .showcase-tag:hover {
    background: var(--purple-glow);
  }

  .terminal {
    background: var(--bg-glass);
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    overflow: hidden;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 0 var(--glass-highlight), var(--card-shadow);
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: rgba(22, 22, 24, 0.8);
    border-bottom: 1px solid var(--border);
  }

  .terminal-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green { background: #28c840; }

  .terminal-body {
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .sl-line1, .sl-line2 {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
  }

  .sl-segment {
    position: relative;
    padding: 1px 2px;
    border-radius: 3px;
    transition: background 0.2s;
    cursor: default;
  }

  .sl-segment.highlighted {
    background: var(--purple-bg);
  }

  .sl-branch {
    color: #e4e4e7;
    font-weight: 500;
  }

  .sl-changes {
    color: #c084fc;
    margin-left: 4px;
  }

  .sl-sep {
    color: #3f3f46;
    margin: 0 6px;
  }

  .sl-cwd {
    color: #71717a;
  }

  .sl-ctx {
    color: rgb(0, 255, 0);
    font-weight: 500;
    transition: color 0.05s linear;
  }

  .sl-model {
    color: rgb(168, 92, 67);
    font-size: 0.8rem;
  }

  .sl-stats {
    color: #0a5c0a;
    margin-left: 4px;
  }

  .sl-port {
    color: #e4e4e7;
    font-size: 0.8rem;
  }

  .tooltip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0.5rem 0;
    opacity: 0;
    transition: opacity 0.2s;
    min-height: 1.5rem;
  }

  .tooltip.visible {
    opacity: 1;
  }

  /* Expand trigger */
  .expand-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.6rem;
    margin-top: 0.5rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .expand-trigger:hover {
    border-color: var(--purple);
    color: var(--text);
  }

  .expand-arrow {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Expanded content */
  .expanded-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;
    opacity: 0;
  }

  .expanded-content.open {
    max-height: 800px;
    opacity: 1;
  }

  .detail-section {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .detail-section:last-child {
    border-bottom: none;
  }

  .detail-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .detail-text {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .detail-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-item {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.85rem;
  }

  .detail-key {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--purple);
    white-space: nowrap;
    min-width: 80px;
  }

  .detail-val {
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
