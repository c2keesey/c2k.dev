---
// All Look Different? — a five-traveller spot check, playable right here.
// Faces and photos come live from the full game at alllookdifferent.c2k.page,
// so this never drifts from the real pool or its credits.
const GAME = 'https://alllookdifferent.c2k.page';
---

<div class="ald-showcase" data-game={GAME}>
  <div class="ald-card">
    <div class="ald-header">
      <span class="ald-name text-scramble" data-text="All Look Different?" data-delay="100" data-always="false">All Look Different?</span>
      <span class="ald-badge">game</span>
    </div>
    <p class="ald-tagline">British, German or French. The face is all you get.</p>

    <div class="ald-desk">
      <div class="ald-photo">
        <img class="ald-img" alt="" hidden />
        <div class="ald-idle">
          <span class="ald-idle-mark" aria-hidden="true">?</span>
        </div>
        <div class="ald-stamp" aria-hidden="true"></div>
      </div>

      <div class="ald-side">
        <div class="ald-readout" aria-live="polite">
          <span class="ald-count">SPOT CHECK: 5 TRAVELLERS</span>
          <span class="ald-score"></span>
        </div>
        <p class="ald-reveal">Real people with one citizenship, photographed for Wikimedia Commons. Stamp the passport you think each one holds.</p>

        <div class="ald-actions">
          <button class="ald-start" type="button">Start the check</button>
          <div class="ald-stamps" role="group" aria-label="Stamp a nationality" hidden>
            <button type="button" data-answer="british">British</button>
            <button type="button" data-answer="german">German</button>
            <button type="button" data-answer="french">French</button>
          </div>
        </div>

        <p class="ald-credit"></p>
      </div>
    </div>

    <div class="ald-footer">
      <a class="ald-link ald-full" href={GAME} target="_blank" rel="noopener">play all 18 at alllookdifferent.c2k.page ↗</a>
      <span class="ald-links">
        <a class="ald-link" href="http://alllooksame.com/" target="_blank" rel="noopener">after alllooksame.com ↗</a>
        <a class="ald-link" href="https://github.com/c2keesey/All-look-different" target="_blank" rel="noopener">github ↗</a>
      </span>
    </div>
  </div>
</div>

<script>
  type Nat = 'british' | 'german' | 'french';
  interface Face { id: string; nationality: Nat; name: string; born: number; image: string; author: string; license: string; source: string; }

  const LABEL: Record<Nat, string> = { british: 'British', german: 'German', french: 'French' };
  const ROUND = 5;

  function shuffle<T>(a: T[]): T[] {
    const s = [...a];
    for (let i = s.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [s[i], s[j]] = [s[j], s[i]];
    }
    return s;
  }

  function initAld(root: HTMLElement) {
    const game = root.dataset.game!;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector(sel) as T;
    const img = $<HTMLImageElement>('.ald-img');
    const idle = $('.ald-idle');
    const stampEl = $('.ald-stamp');
    const count = $('.ald-count');
    const scoreEl = $('.ald-score');
    const reveal = $('.ald-reveal');
    const start = $<HTMLButtonElement>('.ald-start');
    const stamps = $('.ald-stamps');
    const credit = $('.ald-credit');
    const buttons = [...stamps.querySelectorAll<HTMLButtonElement>('button')];

    let pool: Face[] | null = null;
    let round: Face[] = [];
    let i = 0;
    let right = 0;
    let locked = false;

    async function loadPool(): Promise<Face[]> {
      if (pool) return pool;
      const res = await fetch(`${game}/faces.json`);
      if (!res.ok) throw new Error(String(res.status));
      pool = (await res.json()) as Face[];
      return pool;
    }

    function setCredit(f: Face | null) {
      credit.replaceChildren();
      if (!f) return;
      const a = document.createElement('a');
      a.href = f.source; a.target = '_blank'; a.rel = 'noopener'; a.textContent = f.license;
      credit.append(`Photo: ${f.author}, `, a);
    }

    function show() {
      const f = round[i];
      locked = false;
      stampEl.className = 'ald-stamp';
      stampEl.replaceChildren();
      count.textContent = `TRAVELLER ${i + 1}/${ROUND}`;
      scoreEl.textContent = `${right} ✓`;
      reveal.textContent = 'Who issued this passport?';
      reveal.className = 'ald-reveal';
      img.src = `${game}/${f.image}`;
      img.alt = `Traveller ${i + 1}`;
      img.hidden = false;
      idle.hidden = true;
      buttons.forEach(b => (b.disabled = false));
      setCredit(f);
      const next = round[i + 1];
      if (next) new Image().src = `${game}/${next.image}`;
    }

    async function begin() {
      start.disabled = true;
      start.textContent = 'Opening the desk…';
      try {
        const faces = await loadPool();
        const byNat = (n: Nat) => shuffle(faces.filter(f => f.nationality === n));
        // At least one of each, the rest at random, so no round is all one country.
        const firsts = (['british', 'german', 'french'] as Nat[]).map(n => byNat(n)[0]);
        const rest = shuffle(faces.filter(f => !firsts.includes(f))).slice(0, ROUND - 3);
        round = shuffle([...firsts, ...rest]);
        i = 0; right = 0;
        start.hidden = true;
        stamps.hidden = false;
        show();
      } catch {
        start.disabled = false;
        start.textContent = 'Try again';
        reveal.textContent = "The game server didn't answer. It runs on a home server, so it may be down for a bit.";
        reveal.className = 'ald-reveal ald-wrong';
      }
    }

    function stamp(choice: Nat) {
      if (locked) return;
      locked = true;
      const f = round[i];
      const ok = choice === f.nationality;
      if (ok) right++;
      buttons.forEach(b => (b.disabled = true));

      stampEl.className = `ald-stamp ald-${choice} ald-land${ok ? '' : ' ald-void'}`;
      stampEl.style.setProperty('--rot', `${(Math.random() * 22 - 11).toFixed(1)}deg`);
      const b = document.createElement('b');
      b.textContent = LABEL[choice];
      stampEl.replaceChildren(b);

      scoreEl.textContent = `${right} ✓`;
      reveal.className = `ald-reveal ${ok ? 'ald-right' : 'ald-wrong'}`;
      reveal.textContent = ok
        ? `${f.name}, born ${f.born}. ${LABEL[f.nationality]}, right.`
        : `${f.name}, born ${f.born}. ${LABEL[f.nationality]}, not ${LABEL[choice]}.`;

      setTimeout(() => {
        i++;
        if (i < ROUND) show();
        else finish();
      }, ok ? 1300 : 1900);
    }

    function finish() {
      stamps.hidden = true;
      start.hidden = false;
      start.disabled = false;
      start.textContent = 'Check five more';
      count.textContent = 'CHECK COMPLETE';
      scoreEl.textContent = `${right}/${ROUND}`;
      const verdicts = [
        'None. They all look the same to you, then.',
        'One. Guessing would do about as well.',
        'Two. Roughly what guessing gets you.',
        'Three. Better than guessing.',
        'Four. Sharp eyes.',
        'All five. Try the full eighteen.',
      ];
      reveal.className = 'ald-reveal';
      reveal.textContent = verdicts[right];
    }

    start.addEventListener('click', begin);
    buttons.forEach(btn => btn.addEventListener('click', () => stamp(btn.dataset.answer as Nat)));
  }

  document.querySelectorAll<HTMLElement>('.ald-showcase').forEach(initAld);
</script>

<style>
  .ald-showcase {
    --ald-british: 139, 92, 246;
    --ald-german: 16, 185, 129;
    --ald-french: 239, 68, 68;
    --ald-accent: 245, 158, 11;
    margin-bottom: 2rem;
  }

  .ald-card {
    position: relative;
    background: var(--bg-glass);
    border: 1px solid rgba(var(--ald-accent), 0.14);
    border-radius: 12px;
    padding: 1.75rem;
    color: var(--text);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 0 var(--glass-highlight), var(--card-shadow);
  }

  .ald-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
  .ald-name { font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; color: rgb(var(--ald-accent)); }
  .ald-badge {
    font-family: var(--font-mono); font-size: 0.65rem; padding: 0.15rem 0.5rem;
    background: rgba(var(--ald-accent), 0.14); color: rgba(var(--ald-accent), 0.85);
    border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .ald-tagline { font-size: 1rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 1.25rem; }

  .ald-desk { display: grid; grid-template-columns: minmax(0, 220px) 1fr; gap: 1.5rem; align-items: start; }

  .ald-photo {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-code);
    border: 1px solid var(--dash-tooltip-border);
  }
  .ald-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ald-idle { position: absolute; inset: 0; display: grid; place-items: center; }
  .ald-idle[hidden] { display: none; }
  .ald-idle-mark { font-family: var(--font-heading); font-size: 4rem; color: var(--text-ghost); }

  .ald-stamp {
    position: absolute;
    right: 8%; bottom: 8%;
    width: 46%; aspect-ratio: 1;
    border-radius: 50%;
    display: none;
    place-items: center;
    border: 3px solid currentColor;
    background: rgba(10, 10, 12, 0.35);
    transform: rotate(var(--rot, 0deg));
  }
  .ald-stamp::before { content: ""; position: absolute; inset: 5px; border-radius: 50%; border: 1px solid currentColor; }
  .ald-stamp b { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; }
  .ald-stamp.ald-land { display: grid; animation: ald-thump 240ms cubic-bezier(.2, 1.6, .4, 1) both; }
  .ald-stamp.ald-british { color: rgb(var(--ald-british)); }
  .ald-stamp.ald-german { color: rgb(var(--ald-german)); }
  .ald-stamp.ald-french { color: rgb(var(--ald-french)); }
  .ald-stamp.ald-void::after {
    content: "VOID";
    position: absolute;
    font: 800 0.8rem var(--font-mono);
    color: var(--text);
    border: 2px solid var(--text);
    padding: 0 0.3rem;
    transform: rotate(-24deg) translateY(1.3rem);
    background: rgba(10, 10, 12, 0.5);
  }
  @keyframes ald-thump {
    from { transform: rotate(var(--rot, 0deg)) scale(1.7); opacity: 0; }
    to { transform: rotate(var(--rot, 0deg)) scale(1); opacity: 1; }
  }

  .ald-side { display: flex; flex-direction: column; gap: 0.9rem; min-height: 100%; }
  .ald-readout {
    display: flex; justify-content: space-between;
    font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }
  .ald-score { color: rgba(var(--ald-accent), 0.9); }
  .ald-reveal { font-size: 0.85rem; line-height: 1.5; color: var(--text-tertiary); min-height: 3em; }
  .ald-reveal.ald-right { color: rgb(var(--ald-german)); }
  .ald-reveal.ald-wrong { color: rgb(var(--ald-french)); }

  .ald-actions button {
    font: 600 0.8rem var(--font-mono);
    cursor: pointer;
    border-radius: 6px;
    padding: 0.65rem 0.9rem;
    transition: background 150ms, border-color 150ms, transform 80ms;
  }
  .ald-actions button:active:not(:disabled) { transform: translateY(1px); }
  .ald-actions button:disabled { cursor: default; opacity: 0.45; }
  .ald-actions button:focus-visible { outline: 2px solid rgb(var(--ald-accent)); outline-offset: 2px; }

  .ald-start {
    border: 1px solid rgba(var(--ald-accent), 0.4);
    background: rgba(var(--ald-accent), 0.12);
    color: rgb(var(--ald-accent));
  }
  .ald-start:hover:not(:disabled) { background: rgba(var(--ald-accent), 0.2); }
  .ald-start[hidden] { display: none; }

  .ald-stamps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .ald-stamps[hidden] { display: none; }
  .ald-stamps button { border: 1px solid; background: transparent; }
  .ald-stamps [data-answer="british"] { color: rgb(var(--ald-british)); border-color: rgba(var(--ald-british), 0.4); }
  .ald-stamps [data-answer="german"] { color: rgb(var(--ald-german)); border-color: rgba(var(--ald-german), 0.4); }
  .ald-stamps [data-answer="french"] { color: rgb(var(--ald-french)); border-color: rgba(var(--ald-french), 0.4); }
  .ald-stamps [data-answer="british"]:hover:not(:disabled) { background: rgba(var(--ald-british), 0.12); }
  .ald-stamps [data-answer="german"]:hover:not(:disabled) { background: rgba(var(--ald-german), 0.12); }
  .ald-stamps [data-answer="french"]:hover:not(:disabled) { background: rgba(var(--ald-french), 0.12); }

  .ald-credit { margin-top: auto; font-size: 0.68rem; color: var(--text-quaternary); line-height: 1.4; }
  .ald-credit a { color: inherit; }

  .ald-footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem;
    margin-top: 1.4rem; padding-top: 1rem;
    border-top: 1px solid var(--dash-tooltip-border);
  }
  .ald-links { display: flex; gap: 1rem; }
  .ald-link {
    font-family: var(--font-mono); font-size: 0.7rem;
    color: rgba(var(--ald-accent), 0.55); text-decoration: none; transition: color 0.2s;
  }
  .ald-link:hover { color: rgba(var(--ald-accent), 0.95); }
  .ald-full { color: rgba(var(--ald-accent), 0.85); }

  @media (max-width: 560px) {
    .ald-card { padding: 1.25rem; }
    .ald-desk { grid-template-columns: 1fr; }
    .ald-photo { max-width: 260px; width: 100%; margin: 0 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ald-stamp.ald-land { animation: none; }
  }
</style>
